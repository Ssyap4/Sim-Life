{
  "name": "sim-life",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "check": "tsc --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "build": "npm run check && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "audit:furniture": "tsx scripts/auditFurniture.ts"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
